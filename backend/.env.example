# StudioTower Backend Environment Configuration Template
ENV=development
STUDIO_TOWER_AUTH_MODE=dev
STUDIO_TOWER_STORE=memory
STUDIO_TOWER_ARTIFACT_BACKEND=local

# Gemini API Key (optional; deterministic fallback engine used if omitted)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_INFERENCE_TIMEOUT_SECONDS=10.0

# Optional GCP & Monitoring configurations
# GCP_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
# GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_...
# GRAFANA_CLOUD_API_KEY=
# GRAFANA_MCP_ENDPOINT=http://127.0.0.1:8000/mcp
# GRAFANA_BASE_URL=https://loftyladybug3305.grafana.net
# GRAFANA_ALLOWED_HOSTS=loftyladybug3305.grafana.net
# Grafana Cloud OTLP write (Cloud Access Policy glc_ with metrics:write, traces:write).
# Instance service account glsa_ can only read dashboards; it cannot ingest Space events.
# GRAFANA_OTLP_TOKEN=glc_...
# GRAFANA_OTLP_INSTANCE_ID=123456
# GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-2.grafana.net/otlp
