# StudioTower Root Environment Configuration Template
ENV=development
STUDIO_TOWER_AUTH_MODE=dev
STUDIO_TOWER_STORE=memory
STUDIO_TOWER_ARTIFACT_BACKEND=local

# Grafana Cloud MCP (optional locally; required for the Grafana partner track)
# Local uvicorn does not start grafana/mcp-grafana. Production Cloud Run does
# via scripts/docker-start.sh and talks to http://127.0.0.1:8000/mcp.
# Use a Grafana instance service account token (glsa_...), not Cloud Access Policy glc_.
# GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_...
# GRAFANA_CLOUD_API_KEY=
# GRAFANA_MCP_ENDPOINT=http://127.0.0.1:8000/mcp
# GRAFANA_BASE_URL=https://loftyladybug3305.grafana.net
# GRAFANA_ALLOWED_HOSTS=loftyladybug3305.grafana.net
